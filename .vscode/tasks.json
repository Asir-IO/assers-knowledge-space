{
    "version": "2.0.0",
    "inputs": [
        {
        "id": "commitMessage",
        "type": "promptString",
        "description": "Enter commit message (Leave blank for Quartz default)",
        "default": ""
        }
    ],
    "tasks": [
        {
            "label": "quartz run",
            "type": "shell",
            "command": "npx",
            "args": [
                "quartz",
                "build",
                "--serve"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
        "label": "quartz sync",
        "type": "shell",
        "command": "$msg=\"${input:commitMessage}\"; if ([string]::IsNullOrWhiteSpace($msg)) { npx quartz sync } else { npx quartz sync -m \"$msg\" }",
        "group": "build",
        "presentation": {
            "reveal": "always",
            "panel": "shared",
            "clear": true
        },
        "problemMatcher": []
        }
    ]
}