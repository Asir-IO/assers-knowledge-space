{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Enter commit message (Leave blank for Quartz default)",
      "default": ""
    }
  ],
  "tasks": [
    {
      "label": "quartz run",
      "type": "shell",
      "command": "pnpm",
      "args": ["quartz", "build", "--serve"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "quartz sync",
      "type": "shell",
      "command": "if ([string]::IsNullOrWhiteSpace($env:QUARTZ_MSG)) { pnpm quartz sync } else { pnpm quartz sync -m \"$env:QUARTZ_MSG\" }",
      "options": {
        "env": {
          "QUARTZ_MSG": "${input:commitMessage}"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Fix SVGs",
      "type": "shell",
      "command": "py .vscode/fix_svgs.py",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Sync to R2: z1-Assets",
      "type": "shell",
      "command": "powershell -File .vscode/sync-and-purge.ps1",
      "group": "build",
      "dependsOn": "Fix SVGs",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Check for differences: local vs R2",
      "type": "shell",
      "command": "rclone",
      "args": ["check", "content\\z1-Assets", "R2:knowledge-space/knowledgespace/z1-Assets/"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
